{
  "name": "syncsafe",
  "version": "1.0.0",
  "description": "SyncSafe: PS-13 Multi-Device Document Synchronization Prototype",
  "scripts": {
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build:server": "npm run build --prefix server",
    "build:client": "npm run build --prefix client",
    "build": "npm run build:server && npm run build:client",
    "test": "npm test --prefix server",
    "verify:e2e": "npx tsx server/scripts/verify_e2e_flow.ts",
    "verify:audit": "npx tsx server/scripts/verify_audit_phases.ts",
    "start": "node server/dist/index.js"
  },
  "keywords": [
    "sync",
    "offline-first",
    "conflict-resolution",
    "indexeddb",
    "ps-13"
  ],
  "author": "SyncSafe Team",
  "license": "MIT"
}
